# Variables de entorno de ejemplo
# Copia este archivo a .env.local para desarrollo

# Database Configuration
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_API_KEY"
POSTGRES_URL="postgres://YOUR_CONNECTION_STRING"

# Session Security (Generate strong random strings for production)
# You can generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-this-to-a-random-secret-in-production"

# Next.js
NEXT_PUBLIC_APP_NAME="Product Report MVP"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
NODE_ENV="development"

# Security Settings
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME_MINUTES=15
SESSION_DURATION_DAYS=7
SESSION_REFRESH_THRESHOLD_HOURS=24

# Para producción en Vercel, configura estas variables en el dashboard
# NEXT_PUBLIC_API_URL="https://tu-dominio.vercel.app/api"
# NODE_ENV="production"

